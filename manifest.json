{
  "manifest_version": 3,
  "name": "LODVault",
  "version": "1.6.1",
  "key": "",
  "description": "Save, study, and revisit Luxembourgish words directly from lod.lu.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://lod.lu/artikel/*",
    "https://www.lod.lu/artikel/*",
    "https://lod.lu/uploads/*",
    "https://lod.lu/api/*"
  ],
  "action": {
    "default_title": "LODVault",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background-bundle.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "open-lod-lens": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open LOD Lens for the current selection"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lod.lu/*",
        "https://www.lod.lu/*"
      ],
      "js": [
        "scripts/store-core.js",
        "scripts/note-autosave.js",
        "scripts/entry-presenter.js",
        "scripts/shared.js",
        "scripts/lod-article.js",
        "scripts/page-banner.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://lod.lu/*",
        "https://www.lod.lu/*"
      ],
      "js": [
        "scripts/store-core.js",
        "scripts/entry-presenter.js",
        "scripts/shared.js",
        "scripts/lens-lookup.js",
        "scripts/lens-overlay.js",
        "scripts/selection-trigger.js"
      ],
      "css": [
        "styles/lens-overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
