{
  "name": "lod-vault",
  "version": "2.3.0",
  "private": true,
  "description": "Tests and development tooling for the LODVault browser extension.",
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "test:ui": "node scripts/verify-ui-layout.mjs",
    "test:popup": "node scripts/verify-popup-window.mjs",
    "artifacts:webstore": "node media/webstore/render-webstore-images.mjs",
    "build:background": "node scripts/build-background.mjs",
    "package:release": "npm run build:background && bash scripts/build_release_zip.sh",
    "lint": "npm run package:release && web-ext lint --source-dir dist/lodvault-firefox.zip"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "web-ext": "^10.4.0"
  }
}
